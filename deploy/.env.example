# Copy to deploy/.env (git-ignored) and fill in. Never commit the filled file.
POSTGRES_PASSWORD=change-me
# The compose Postgres; point it elsewhere for a managed database.
DATABASE_URL=postgres://agir:change-me@postgres:5432/agir
# At least 32 random bytes, e.g. `openssl rand -hex 32`. Changing it makes every stored run fail its signature check.
AGIR_RUN_SIGNING_SECRET=
# The address people use, with https; links in email are built from it.
AGIR_PUBLIC_ORIGIN=https://agir.example.ca
# 1 only when exactly one proxy in front sets x-forwarded-for.
AGIR_TRUST_PROXY=
# The port on 127.0.0.1 where the proxy reaches the API.
AGIR_HOST_PORT=8787
# open (anyone may create an account) or invite (only a client invitation does, during the pilot).
AGIR_SIGNUP=invite
# Where alerts are POSTed as JSON; empty means none.
AGIR_ALERT_URL=
# 1 offers closing a workspace and deleting an account; the retention period in whole days (empty keeps closed workspaces).
AGIR_ACCOUNT_CLOSURE=
AGIR_RETENTION_DAYS=

# Blobs: file (the shared volume, the default) or s3.
AGIR_BLOB_STORE=file
AGIR_S3_BUCKET=
AGIR_S3_REGION=ca-central-1
AGIR_S3_ENDPOINT=
AGIR_S3_PREFIX=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Set to turn on AI reading (see docs/deploy.md); empty, the rule reader alone reads.
ANTHROPIC_API_KEY=
