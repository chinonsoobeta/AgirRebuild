  "openQuestions": [
    {
      "id": "Q1",
      "topic": "Spread of soft cost and contingency",
      "ruleUsed": "Deal states S-curve for hard cost only; soft and contingency also spread by S-curve over [0,C).",
      "affects": [
        "total_development_cost",
        "capitalized_interest",
        "required_equity"
      ]
    },
    {
      "id": "Q2",
      "topic": "Cent allocation method",
      "ruleUsed": "Each line allocated separately; month m = ROUND(X*f((m+1)/C),2) - ROUND(X*f(m/C),2), f = smoothstep 3x^2-2x^3, so the line sums exactly.",
      "affects": [
        "capitalized_interest",
        "total_development_cost"
      ]
    },
    {
      "id": "Q3",
      "topic": "Other income growth and lease-up levels",
      "ruleUsed": "Other income grows with rent growth by hold year; lease-up months use year-1 rent, other income and fixed costs.",
      "affects": [
        "effective_gross_income",
        "stabilized_noi",
        "stated_value",
        "unrealized_equity_multiple"
      ]
    },
    {
      "id": "Q4",
      "topic": "Lease-up ramp application",
      "ruleUsed": "Ramp (k+0.5)/L applied to EGI (occupied rent + other income); fixed costs and property tax due in full; net paid at S as the lease-up flow; interest during lease-up capitalized.",
      "affects": [
        "unrealized_equity_multiple",
        "unrealized_equity_irr",
        "peak_equity"
      ]
    },
    {
      "id": "Q5",
      "topic": "Expense ratio fixed dollars under stresses",
      "ruleUsed": "Fixed dollars = expense ratio x year-1 stabilized EGI of that scenario (recomputed in rent, occupancy and expense stresses). Expense stress adds 5 points to the 27% ratio; property tax unchanged.",
      "affects": [
        "stabilized_noi",
        "sizing_dscr",
        "unrealized_equity_multiple"
      ]
    },
    {
      "id": "Q6",
      "topic": "Cost stress scope",
      "ruleUsed": "x1.10 on land, land transfer tax, development charges, hard, soft, contingency and GST/HST net (0); debt commitment unchanged, equity absorbs.",
      "affects": [
        "total_development_cost",
        "required_equity"
      ]
    },
    {
      "id": "Q7",
      "topic": "Rate stress scope",
      "ruleUsed": "+1.50 points on construction loan rate and refinance loan rate.",
      "affects": [
        "capitalized_interest",
        "sizing_dscr",
        "dcr_after_refinance"
      ]
    },
    {
      "id": "Q8",
      "topic": "Rent stress scope",
      "ruleUsed": "x0.90 on unit rents; other income not stressed.",
      "affects": [
        "gross_potential_rent",
        "stabilized_noi"
      ]
    },
    {
      "id": "Q9",
      "topic": "Refinance timing of first payment",
      "ruleUsed": "Refinance at start of month R: senior retired with no month-R senior interest; the new loan's first level payment is due in month R. Senior DS cash in months S..R-1 is interest only.",
      "affects": [
        "dcr_after_refinance",
        "sizing_dscr",
        "stated_value"
      ]
    },
    {
      "id": "Q10",
      "topic": "senior_dscr_year1 with a refinance in year 1",
      "ruleUsed": "Uses the senior position's sizing DS: construction loan IO (months 22-23) then refinance level payment (months 24-33); equals sizing_dscr_year1.",
      "affects": [
        "senior_dscr_year1"
      ]
    },
    {
      "id": "Q11",
      "topic": "break_even_occupancy definition",
      "ruleUsed": "Year-1 (fixed opex + property tax + DS due) / year-1 GPR; other income excluded from 'rent'; variable share 0.",
      "affects": [
        "break_even_occupancy"
      ]
    },
    {
      "id": "Q12",
      "topic": "Distributions include the lease-up flow",
      "ruleUsed": "The multiple counts the lease-up net income flow at S as a distribution (metrics.md lists only operating, refinance and unrealized; economic-model says all positive flows count). Followed economic-model.md.",
      "affects": [
        "unrealized_equity_multiple"
      ]
    },
    {
      "id": "Q13",
      "topic": "Error checks scope",
      "ruleUsed": "Error checks evaluated on base case only; stress sheets feed only their gates.",
      "affects": [
