      ]
    },
    {
      "id": "Q14",
      "topic": "IRR roots",
      "ruleUsed": "Monthly IRR annualized as (1+r)^12-1 (flows dated m/12 compounding annually); root count by NPV sign scan over annual rates -99%..2000%; value only if exactly one root.",
      "affects": [
        "unrealized_equity_irr"
      ]
    },
    {
      "id": "Q15",
      "topic": "total_debt timing",
      "ruleUsed": "Balance at S (senior, incl. capitalized interest), i.e. the commitment when converged.",
      "affects": [
